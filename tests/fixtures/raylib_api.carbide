// raylib_api.carbide - raylib bindings written in Carbide.
//
// Transpiles a representative slice of the raylib C API (window / drawing /
// textures / audio) into FFI-compliant, no_std Rust.  Struct layouts mirror
// the C ABI 1:1:
//
//   - float/int/unsigned char/... C primitives map to c_float/c_int/c_uchar;
//   - `T const*` postfix pointers map to `*const T`;
//   - C typedefs map to `type` aliases (Texture2D, AudioCallback, ...);
//   - C function pointers map to `fn(...) -> ...` types
//     (AudioCallback is raylib's audio-thread callback typedef).
//
// Every procedure here is a *stub* with an `unimplemented!()` body: the
// dialect emits definitions, so a real project would link these against the
// C library by replacing the bodies with FFI calls, or implement them in
// Rust and expose them back to C (the raylib host).  The signatures are the
// API contract; they transpile and compile as-is.
//
// Source: https://github.com/raysan5/raylib (zlib) - src/raylib.h
// Reference Rust binding: https://github.com/deltaphc/raylib-rs

// ---------------------------------------------------------------------------
// C typedef aliases (src/raylib.h)
// ---------------------------------------------------------------------------

type Texture2D = Texture;
type TextureCubemap = Texture;
type RenderTexture2D = RenderTexture;
type Quaternion = Vector4;

// Audio thread callback: void (*AudioCallback)(void *bufferData, unsigned int frames);
// Used by SetAudioStreamCallback() to pull new PCM data on the audio thread.
type AudioCallback = fn(buffer: void*, frames: uint) -> void;

// ---------------------------------------------------------------------------
// Math / colour / shape types (src/raylib.h)
// ---------------------------------------------------------------------------

struct Vector2 {
    x: float,
    y: float
}

struct Vector3 {
    x: float,
    y: float,
    z: float
}

struct Vector4 {
    x: float,
    y: float,
    z: float,
    w: float
}

struct Matrix {
    m0: float, m4: float, m8: float, m12: float,
    m1: float, m5: float, m9: float, m13: float,
    m2: float, m6: float, m10: float, m14: float,
    m3: float, m7: float, m11: float, m15: float
}

struct Color {
    r: unsigned char,
    g: unsigned char,
    b: unsigned char,
    a: unsigned char
}

struct Rectangle {
    x: float,
    y: float,
    width: float,
    height: float
}

// ---------------------------------------------------------------------------
// Images, textures, render textures (src/raylib.h)
// ---------------------------------------------------------------------------

struct Image {
    data: void*,
    width: int,
    height: int,
    mipmaps: int,
    format: int
}

struct Texture {
    id: uint,
    width: int,
    height: int,
    mipmaps: int,
    format: int
}

struct RenderTexture {
    id: uint,
    texture: Texture,
    depth: Texture
}

struct GlyphInfo {
    value: int,
    offset_x: int,
    offset_y: int,
    advance_x: int,
    image: Image
}

struct Font {
    base_size: int,
    glyph_count: int,
    glyph_padding: int,
    texture: Texture2D,
    recs: Rectangle*,
    glyphs: GlyphInfo*
}

// ---------------------------------------------------------------------------
// Cameras (src/raylib.h)
// ---------------------------------------------------------------------------

struct Camera3D {
    position: Vector3,
    target: Vector3,
    up: Vector3,
    fovy: float,
    projection: int
}

struct Camera2D {
    offset: Vector2,
    target: Vector2,
    rotation: float,
    zoom: float
}

// ---------------------------------------------------------------------------
// Audio module (src/raylib.h)
// ---------------------------------------------------------------------------

// Opaque internal audio engine handles (defined by the raylib C library).
struct rAudioBuffer {}

struct rAudioProcessor {}

struct Wave {
    frame_count: uint,
    sample_rate: uint,
    sample_size: uint,
    channels: uint,
    data: void*
}

struct AudioStream {
    buffer: rAudioBuffer*,
    processor: rAudioProcessor*,
    sample_rate: uint,
    sample_size: uint,
    channels: uint
}

struct Sound {
    stream: AudioStream,
    frame_count: uint
}

struct Music {
    stream: AudioStream,
    frame_count: uint,
    looping: bool,
    ctx_type: int,
    ctx_data: void*
}

