// ---------------------------------------------------------------------------
// Helpers with real bodies (demonstrate usable Carbide code)
// ---------------------------------------------------------------------------

// Colour constructor mirroring raylib's RAYLIBAPI Color (r, g, b, a) helper
// convention.  `unsigned char` fields map to c_uchar (u8 on all targets).
fn raylib_color(r: u8, g: u8, b: u8, a: u8) -> Color {
    let mut c: Color = Color { r: r, g: g, b: b, a: a };
    return c;
}

// 2D vector distance; exercises field access on a value type.
fn vector2_length_squared(v: Vector2) -> float {
    return v.x * v.x + v.y * v.y;
}
